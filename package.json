{
  "name": "memopad",
  "displayName": "memopad",
  "description": "Notes where you code. No new window, no context switch. Plain text files you own.",
  "version": "1.4.0",
  "publisher": "gundurraga",
  "icon": "logo.png",
  "repository": {
    "type": "git",
    "url": "https://github.com/gundurraga/memopad"
  },
  "license": "MIT",
  "engines": {
    "vscode": "^1.80.0"
  },
  "categories": [
    "Machine Learning"
  ],
  "keywords": [
    "notes",
    "prompts",
    "snippets",
    "sidebar",
    "local",
    "plain-text",
    "ai-prompts",
    "notepad",
    "memo"
  ],
  "activationEvents": [],
  "main": "./extension.js",
  "scripts": {
    "lint": "node --check extension.js && node --check note-order.js && node --check test/ordering.test.js && node --check scripts/test-host.js && node --check test/extension-host.js",
    "test": "node --test test/*.test.js",
    "test:host": "node scripts/test-host.js"
  },
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "memopad",
          "title": "memopad",
          "icon": "$(note)"
        }
      ]
    },
    "views": {
      "memopad": [
        {
          "id": "memopadNotes",
          "name": "Notes",
          "canMoveViews": true
        }
      ]
    },
    "commands": [
      {
        "command": "memopad.addNote",
        "title": "Add Note",
        "icon": "$(add)"
      },
      {
        "command": "memopad.addFolder",
        "title": "Add Folder",
        "icon": "$(new-folder)"
      },
      {
        "command": "memopad.copyNote",
        "title": "Copy Note",
        "icon": "$(copy)"
      },
      {
        "command": "memopad.copyPath",
        "title": "Copy Path",
        "icon": "$(link)"
      },
      {
        "command": "memopad.deleteItem",
        "title": "Delete",
        "icon": "$(trash)"
      },
      {
        "command": "memopad.renameItem",
        "title": "Rename",
        "icon": "$(edit)"
      },
      {
        "command": "memopad.search",
        "title": "Search Notes",
        "icon": "$(search)"
      },
      {
        "command": "memopad.expandAll",
        "title": "Expand All Folders",
        "icon": "$(expand-all)"
      },
      {
        "command": "memopad.collapseAll",
        "title": "Collapse All Folders",
        "icon": "$(collapse-all)"
      },
      {
        "command": "memopad.moveToTop",
        "title": "Move to Top",
        "icon": "$(arrow-up)"
      },
      {
        "command": "memopad.moveUp",
        "title": "Move Up",
        "icon": "$(chevron-up)"
      },
      {
        "command": "memopad.moveDown",
        "title": "Move Down",
        "icon": "$(chevron-down)"
      },
      {
        "command": "memopad.resetOrder",
        "title": "Reset Folder Order",
        "icon": "$(list-ordered)"
      }
    ],
    "menus": {
      "view/title": [
        {
          "command": "memopad.search",
          "when": "view == memopadNotes",
          "group": "navigation@1"
        },
        {
          "command": "memopad.addNote",
          "when": "view == memopadNotes",
          "group": "navigation@2"
        },
        {
          "command": "memopad.addFolder",
          "when": "view == memopadNotes",
          "group": "navigation@3"
        },
        {
          "command": "memopad.expandAll",
          "when": "view == memopadNotes && !memopad.allExpanded",
          "group": "navigation@4"
        },
        {
          "command": "memopad.collapseAll",
          "when": "view == memopadNotes && memopad.allExpanded",
          "group": "navigation@4"
        },
        {
          "command": "memopad.resetOrder",
          "when": "view == memopadNotes",
          "group": "order"
        }
      ],
      "view/item/context": [
        {
          "command": "memopad.addNote",
          "when": "view == memopadNotes && viewItem == folder"
        },
        {
          "command": "memopad.addFolder",
          "when": "view == memopadNotes && viewItem == folder"
        },
        {
          "command": "memopad.copyNote",
          "when": "view == memopadNotes && viewItem == note",
          "group": "inline"
        },
        {
          "command": "memopad.copyPath",
          "when": "view == memopadNotes"
        },
        {
          "command": "memopad.renameItem",
          "when": "view == memopadNotes"
        },
        {
          "command": "memopad.deleteItem",
          "when": "view == memopadNotes"
        },
        {
          "command": "memopad.moveToTop",
          "when": "view == memopadNotes",
          "group": "order@1"
        },
        {
          "command": "memopad.moveUp",
          "when": "view == memopadNotes",
          "group": "order@2"
        },
        {
          "command": "memopad.moveDown",
          "when": "view == memopadNotes",
          "group": "order@3"
        },
        {
          "command": "memopad.resetOrder",
          "when": "view == memopadNotes && viewItem == folder",
          "group": "order@4"
        }
      ]
    }
  }
}
